# =============================================
# SCM FRONTEND — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local dev
# Set these in Netlify dashboard for production
# =============================================

# Public backend URL (used by browser-side code AND as Netlify fallback for BFF routes)
NEXT_PUBLIC_API_URL=https://scm-backend-ork4.onrender.com

# Server-side backend URL (used exclusively by Next.js API Routes / BFF)
# LOCAL:  http://127.0.0.1:5000  (use 127.0.0.1, NOT localhost — Node 18+ IPv6 issue)
# NETLIFY: Set to https://scm-backend-ork4.onrender.com (same as NEXT_PUBLIC_API_URL)
API_BASE_URL=http://127.0.0.1:5000

# Site URL for SEO and Sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Razorpay public key ID (safe to expose — only the key_id, not secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
